<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cyber">

    <!-- WebView -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Startup Splash / Progress Overlay -->
    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/bg_cyber"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent_teal"
            android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OncoFusion AI"
                android:textColor="@color/accent_teal"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Establishing diagnostic cockpit link..."
            android:textColor="@color/text_slate"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Connection Error / URL Config Layout -->
    <ScrollView
        android:id="@+id/layout_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_cyber"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ ! ]"
                android:textColor="@color/error_red"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIAGNOSTIC TUNNEL OFFLINE"
                android:textColor="@color/error_red"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Could not establish connection to the diagnostic cockpit host. Please verify that the clinical platform is running and accessible."
                android:textColor="@color/text_light"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- Card for server URL config -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ONCOFUSION AI SERVER ENDPOINT"
                    android:textColor="@color/text_slate"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/edit_server_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="https://oncofusion-ai.streamlit.app"
                    android:textColorHint="@color/text_slate"
                    android:inputType="textUri"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_save_connect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apply and Reconnect"
                    android:backgroundTint="@color/accent_teal"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_error_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Error details: -"
                android:textColor="@color/text_slate"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="Retry Connection"
                android:backgroundTint="@color/accent_teal_dark"
                android:textColor="@color/white" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
